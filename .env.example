# Copy to .env.local and fill in real values. NEVER commit a populated .env.local.
#
# Firebase client config (public identifiers, safe in a browser bundle).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Layan backend base URL — the layan-salon Express server.
# Local:  http://localhost:5000/api
# Vercel: https://layan-salon-jet.vercel.app/api
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api

# Stripe test publishable key (pk_test_...).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Cloudinary cloud name, used for the image-upload UI.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Canonical origin, used for metadata / OG tags / sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
